# --- Required for AI tailoring ---
# Get one at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional: override the model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional bounded role research. Enabled by default; set to false to tailor
# from the complete job description only.
# ROLE_RESEARCH_ENABLED=true

# Cache lifetime for normalized role + functional-domain research (30-60 days).
# Default: 45 days.
# ROLE_RESEARCH_CACHE_DAYS=45

# --- Live jobs ---
# Jobs are read for free from employer career sites (lib/freeJobs/sources.ts);
# no API key is needed. Optional tuning:
# FREE_JOBS_MAX_AGE_DAYS=30
# FREE_JOBS_TITLE_MODE=tight          # or "broad"
# FREE_JOBS_SYNC_DEADLINE_SECONDS=50  # Vercel's route limit is 60s
# FREE_JOBS_WORKDAY_MAX_ROWS=200      # most jobs read from one Workday site
# FREE_JOBS_ORACLE_MAX_ROWS=300       # most jobs read from one Oracle site

# Used only by the "LinkedIn only" toggle. Keep this server-side.
# Get a key at https://theirstack.com/
THEIRSTACK_API_KEY=your-theirstack-api-key

# Optional LinkedIn refresh cap (25-250). Default: 150 returned records.
# THEIRSTACK_MAX_RESULTS=150

# Private durable storage for the profile, job feeds, and restart-safe request
# guards. Required for TheirStack and recommended for production;
# without it, local development falls back to process memory only.
# Use the same token on every server instance.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# Optional: disable real Claude and TheirStack calls.
# DEMO_MODE=true

# --- Site password gate ---
# Required to protect the paid API usage behind this site from public/bot traffic.
SITE_PASSWORD=change-me
