# --- Required for AI tailoring ---
# Get one at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional: override the model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: live jobs ---
# Without this, the app serves realistic sample jobs so the demo still runs.
# Get a key at https://hirebase.org/
HIREBASE_API_KEY=your-hirebase-api-key

# Used only by the "LinkedIn only" toggle. Keep this server-side.
# Get a key at https://theirstack.com/
THEIRSTACK_API_KEY=your-theirstack-api-key

# Private durable storage for the profile and last successful job feeds.
# Required when THEIRSTACK_API_KEY is enabled so restarts cannot bypass the
# 12-hour paid-request cooldown. Use the same token on every server instance.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# Optional: disable real Claude, Hirebase, and TheirStack calls.
# DEMO_MODE=true

# --- Site password gate ---
# Required to protect the paid API usage behind this site from public/bot traffic.
SITE_PASSWORD=change-me
