# --- Required for AI tailoring ---
# Get one at https://console.anthropic.com  → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional: override the model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: live jobs ---
# Without this, the app serves realistic sample jobs so the demo still runs.
# Get a key on RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=your-rapidapi-key

# Optional: always use the free simulated analysis preview instead of Claude.
# DEMO_MODE=true

# --- Site password gate ---
# Required to protect the paid API usage behind this site from public/bot traffic.
SITE_PASSWORD=change-me